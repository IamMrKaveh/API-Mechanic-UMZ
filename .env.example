# ============================================================================
# Mechanic.Api - copy this file to .env and fill in real values.
# .env is GITIGNORED; this template is committed.
# Real environment variables (Docker/K8s/CI) always take precedence over .env.
# ============================================================================

# --- Runtime environment ---
# The docker-compose api service defaults to Production (no dev error pages in a
# container). Production startup validation requires Redis with TLS, which the
# local compose stack does not provide - uncomment for local docker usage:
# ASPNETCORE_ENVIRONMENT=Development

# --- JWT signing (HS256, minimum 32 bytes). Generate: openssl rand -base64 48
Jwt__Key=

# --- OTP HMAC pepper (min 16 chars; generate: openssl rand -base64 48) ---
Auth__OtpPepper=

# --- Kavenegar SMS API key ---
Kavenegar__ApiKey=

# --- ArvanCloud S3 object storage (Storage + AWS:S3 sections) ---
Storage__AccessKey=
Storage__SecretKey=
AWS__S3__AccessKey=
AWS__S3__SecretKey=

# --- Bootstrap admin phone (E.164 without '+', e.g. 989121234567 style) ---
InitialAdmin__PhoneNumbers__0=

# --- PostgreSQL (local development) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ledka;Username=postgres;Password=CHANGE_ME
ConnectionStrings__PoolerConnection=Host=localhost;Port=5432;Database=ledka;Username=postgres;Password=CHANGE_ME
ConnectionStrings__DirectConnection=Host=localhost;Port=5432;Database=ledka;Username=postgres;Password=CHANGE_ME
ConnectionStrings__MigrationConnection=Host=localhost;Port=5432;Database=ledka;Username=postgres;Password=CHANGE_ME;Pooling=false;Max Auto Prepare=0;No Reset On Close=true

# --- Payment webhook hardening ---
# Keep true: the callback nonce (issued at initiation) is always validated.
FeatureManagement__PaymentCallbackSignatureRequired=true
# Production MUST set this to true AND list Zarinpal's official callback IPs.
FeatureManagement__PaymentCallbackIpWhitelistRequired=false
Zarinpal__AllowedIps__0=
Zarinpal__AllowedIps__1=

# --- SMTP (uncomment and fill if email notifications are used) ---
# Smtp__Host=
# Smtp__Port=587
# Smtp__Username=
# Smtp__Password=
# Smtp__FromEmail=
# Smtp__FromName=
